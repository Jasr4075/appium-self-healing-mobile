# ==========================================
# ⚕️ APPIUM SELF-HEALING CONFIGURATION
# ==========================================

# Ativação e Thresholds
# Nota: SELF_HEALING_ENABLED é informativo. O controle em runtime é feito via
# options.enabled no initialize(driver, spec, { enabled: true|false }).
SELF_HEALING_ENABLED=true
HEALING_DEBUG=false
HEALING_MIN_THRESHOLD=0.70

# Caminhos Customizados (Opcional)
# Se não informados, o padrão será a pasta ./output/logs/self-healing/ na raiz de onde o teste rodar
# HEALING_LOG_DIR=./custom/path/to/logs
# HEALING_HISTORY_PATH=./custom/path/to/history/selector-history.json

# Pesos Heurísticos (A soma deve ser preferencialmente 1.0)
HEALING_WEIGHT_CLASS=0.4
HEALING_WEIGHT_TEXT=0.3
HEALING_WEIGHT_ID=0.2
HEALING_WEIGHT_POSITION=0.1