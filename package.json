{
  "name": "appium-self-healing-mobile",
  "version": "1.0.1",
  "description": "An intelligent, heuristic-based self-healing mechanism for Appium and WebdriverIO mobile automation.",
  "type": "module",
  "main": "src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 --all --include=src --check-coverage --lines 100 --branches 100 --functions 100 --statements 100 --reporter=lcov --reporter=json-summary --reporter=text npm test",
    "test:types": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" index.d.ts",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" index.d.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "mobile-testing",
    "self-healing",
    "qa",
    "automation",
    "e2e"
  ],
  "author": "Juan Angel Sarmiento Rodriguez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jasr4075/appium-self-healing-mobile.git"
  },
  "homepage": "https://github.com/Jasr4075/appium-self-healing-mobile#readme",
  "bugs": {
    "url": "https://github.com/Jasr4075/appium-self-healing-mobile/issues"
  },
  "peerDependencies": {
    "webdriverio": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
